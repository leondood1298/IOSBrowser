<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.leondood1298.browser.downloads.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Files</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.leondood1298.browser</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>iosbrowser</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlechrome</string>
		<string>googlechromes</string>
		<string>firefox</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>io.github.leondood1298.browser.open-url</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Websites you visit can ask to use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Websites you visit can ask to use the microphone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Websites you visit can ask for your location.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images and videos from the web to your photo library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock the browser with Face ID.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Open websites and devices on your local network.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
